{
  "name": "monoleaf",
  "private": true,
  "version": "1.1.0",
  "description": "A portable, WYSIWYG Markdown editor — one file, single source of truth.",
  "license": "MIT",
  "author": "vibingbiochemist <info@monoleaf.org>",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibingbiochemist/Monoleaf.git"
  },
  "bugs": {
    "url": "https://github.com/vibingbiochemist/Monoleaf/issues"
  },
  "homepage": "https://monoleaf.org",
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "markdown-editor",
    "tauri",
    "portable"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses": "node scripts/generate-licenses.mjs",
    "tauri": "tauri",
    "postinstall": "patch-package",
    "test:e2e": "node --test --test-timeout=120000 \"e2e/**/*.test.mjs\""
  },
  "overrides": {
    "katex": "$katex"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@vscode/markdown-it-katex": "^1.1.2",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.13",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.4",
    "markdown-it": "^15.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "pagedjs": "^0.4.3",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.1.2",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "jsdom": "^30.0.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "patch-package": "^8.0.1",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.9.6",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
